# Agente de anúncios + leitura de materiais (Python) — roda 24 h no servidor Hetzner.
FROM python:3.12-slim

RUN apt-get update \
  && apt-get install -y --no-install-recommends ffmpeg poppler-utils ca-certificates curl nodejs npm \
  && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir pillow==11.0.0 numpy==2.1.3 edge-tts==6.1.12

# CLI da Higgsfield (opcional): passe o pacote no build se for usar cenas de IA no servidor.
ARG HIGGSFIELD_CLI_NPM=""
RUN if [ -n "$HIGGSFIELD_CLI_NPM" ]; then npm install -g "$HIGGSFIELD_CLI_NPM"; fi

WORKDIR /app
COPY worker/agente ./worker/agente
COPY worker/pipeline_py ./worker/pipeline_py
COPY worker/assets ./worker/assets
COPY scripts ./scripts
COPY lib/marketplace/data ./lib/marketplace/data

ENV PYTHONUNBUFFERED=1
CMD ["python3", "worker/agente/ads_agent.py"]
