# Supabase → Project Settings → API
SUPABASE_URL=https://zsiamfqeogowlssmxzmd.supabase.co
SUPABASE_ANON_KEY=
# login de um admin do portal (o agente age como ele; as regras de segurança do banco valem)
SUPABASE_EMAIL=admin@fortunacreative.com.br
SUPABASE_PASSWORD=
