# Fortuna Creative — Render Worker env (LOCAL, roda na sua máquina)
# Copie para .env e preencha. `npm run worker` carrega este .env automaticamente.
# IMPORTANTE: SUPABASE_SERVICE_ROLE_KEY é SECRETA. Nunca versione o .env real.
#
# Pré-requisitos fora do .env:
#   - higgsfield CLI instalado E LOGADO no PATH (`higgsfield --version` funciona)
#   - ffmpeg + ffprobe no PATH
#   - Python 3.10+ no PATH com: pip install pillow numpy edge-tts

# Supabase (Project Settings -> API)
SUPABASE_URL=https://zsiamfqeogowlssmxzmd.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<colar do dashboard Supabase → Settings → API → service_role>

# Identidade deste worker (qualquer string estável; default = hostname)
WORKER_ID=

# Intervalo de polling em ms (default 5000)
POLL_INTERVAL_MS=5000

# Binário do Python (default: python). ATENÇÃO: se `python` no PATH apontar
# pra outra venv (ex.: hermes), aponte aqui o Python real com pillow/numpy:
# PYTHON_BIN=C:\Users\f.serrano\AppData\Local\Programs\Python\Python312\python.exe
PYTHON_BIN=python

# --- Locução (opcional) ---
# Com key: ElevenLabs (voz pt-BR multilingual). Sem key: fallback edge-tts
# (pt-BR-FranciscaNeural), grátis, sem cadastro.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB

# --- Refino de copy (opcional) ---
# Com key: hook/CTA refinados via xAI. Sem key: templates do briefing.
XAI_API_KEY=
XAI_MODEL=grok-4
